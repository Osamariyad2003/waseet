# ---------------------------------------------------------------------------
# Waseet — environment template.
# Copy to backend/.env and fill in. Never commit the real .env.
# Everything runs against the PayPal SANDBOX. No real money.
# ---------------------------------------------------------------------------

# --- PayPal (sandbox) ------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: a ready-made sandbox access token (e.g. from the PayPal AI
# Toolkit / `/paypal:setup`, mirrored from ~/.claude/settings.json). When set,
# the server uses it for REST calls and only falls back to the client
# id/secret above if it is rejected. Leave blank to always mint our own.
PAYPAL_SANDBOX_ACCESS_TOKEN=
# Created in the PayPal dashboard once a public webhook URL exists (Phase 3).
PAYPAL_WEBHOOK_ID=
# Sandbox personal account that receives payouts on release.
PAYPAL_SELLER_RECEIVER_EMAIL=

# --- Email notifications (optional) ----------------------------------------
# Real email on lifecycle events (funded / delivered / released / disputed).
# Off by default: the app just logs what it would send. Turn it on with a
# Gmail App Password (Google account → Security → 2-Step Verification → App
# passwords) — NOT your normal Gmail password.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=
# Defaults to SMTP_USERNAME. Links in emails point back to the app here.
SMTP_FROM=
APP_BASE_URL=http://localhost:3000

# --- AI provider -----------------------------------------------------------
# Which provider backs the judgment agents: anthropic or gemini. Both run
# the same agent logic and guardrails (app/integrations/ai/base.py); only
# the API call differs. USE_STUB_AI (below) overrides this for a keyless demo.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: force a specific model id for the selected provider.
# AI_MODEL_OVERRIDE=

# --- Channel3 product catalog (Shop & Escrow) ------------------------------
# A real product catalog a buyer can search to start an escrow deal from.
# Get a free key (1,000 searches/month, no card) at channel3.ai. Without a
# key, a small stub catalog stands in so the flow works keyless.
CHANNEL3_API_KEY=
# CHANNEL3_BASE_URL=https://api.trychannel3.com/v1
