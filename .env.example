# ---------------------------------------------------------------------------
# Waseet — environment template.
# Copy to backend/.env and fill in. Never commit the real .env.
# Everything runs against the PayPal SANDBOX. No real money.
# ---------------------------------------------------------------------------

# --- PayPal (sandbox) ------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Created in the PayPal dashboard once a public webhook URL exists (Phase 3).
PAYPAL_WEBHOOK_ID=
# Sandbox personal account that receives payouts on release.
PAYPAL_SELLER_RECEIVER_EMAIL=

# --- AI provider -----------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://waseet:waseet@localhost:5432/waseet

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# --- Decision policy / settlement -----------------------------------------
# Auto-release only on a PASS verdict at or above this confidence. Anything
# else — fail, low confidence, malformed model output, buyer contest — goes
# to DISPUTED for a human.
AUTO_RELEASE_CONFIDENCE_THRESHOLD=0.8
# FR-13, optional. 0 = no fee.
PLATFORM_FEE_PERCENT=0

# --- Timeouts / resilience -------------------------------------------------
PAYPAL_TIMEOUT_SECONDS=15
AI_TIMEOUT_SECONDS=45

# --- Runtime ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Dev-only: enables the unsigned webhook simulation endpoint so the demo does
# not depend on a public tunnel. MUST stay false outside development.
ENABLE_WEBHOOK_SIMULATOR=true

# --- Frontend (frontend/.env.local) ---------------------------------------
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
